<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>KiarashMinoo.PasswordGenerator</PackageId>
        <AssemblyName>KiarashMinoo.PasswordGenerator</AssemblyName>
        <RootNamespace>KiarashMinoo.PasswordGenerator</RootNamespace>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageTags>password;security;cryptography;generator</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="README.md"/>
        <None Include="icon.png" Pack="true" PackagePath="icon.png"/>
    </ItemGroup>
</Project>